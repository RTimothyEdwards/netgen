# Wishrc startup for ToolScript (netgen)
#
# For installation:  Put this file and also tclnetgen.so into
# directory ${CAD_ROOT}/netgen/tcl/, and set the "load" line below
# to point to the location of tclnetgen.so.  Also see comments
# in shell script "netgen.sh".
#

# Check namespaces for existence of other applications
set UsingMagic 0
set UsingXCircuit 0
set UsingIRSIM 0
set batchmode 0
set nlist [namespace children]
foreach i $nlist {
   switch $i {
      ::magic { set UsingMagic 1 }
      ::xcircuit { set UsingXCircuit 1 }
      ::irsim { set UsingIRSIM 1 }
   }
}

# -lazy option not needed if stubs libraries are handled correctly
# load -lazy TCL_DIR/tclnetgenSHDLIB_EXT

if { [info exists CAD_ROOT] && [file exists $CAD_ROOT/netgen/tcl/tclnetgenSHDLIB_EXT] } {
    load $CAD_ROOT/netgen/tcl/tclnetgenSHDLIB_EXT
} else {
    load TCL_DIR/tclnetgenSHDLIB_EXT
}

# "netgen --version" prints the version number (e.g., "1.5.330") and exits
if {[info exists argv] && ([lsearch -exact $argv "--version"] >= 0)} {
   puts stdout $netgen_version
   exit 0
}

#----------------------------------------------------------------
# Convert LVS list result into a JSON file 
#----------------------------------------------------------------

proc netgen::convert_to_json {filename lvs_final} {
   set pidx [string last . $filename]
   set jsonname [string replace $filename $pidx end ".json"]
   if {![catch {open $jsonname w} fjson]} {
      puts $fjson "\["
      # Outer list is of each cell compared
      set clen [llength $lvs_final]
      set cidx 0
      foreach circuit $lvs_final {
         incr cidx
         puts $fjson "  \{"
         set nkeys [llength $circuit]
         set kidx 0
	 foreach {key value} $circuit {
            incr kidx 2
	    switch $key {
	       name {
	          puts $fjson "   \"${key}\": \["
		  set cktval [lindex $value 0]
		  puts $fjson "      \"${cktval}\","
		  set cktval [lindex $value 1]
		  puts $fjson "      \"${cktval}\""
		  if {$kidx == $nkeys} {
		     puts $fjson "   \]"
		  } else {
		     puts $fjson "   \],"
		  }
	       }
	       pins {
	          puts $fjson "   \"${key}\": \["
	          puts $fjson "      \["
		  set cktval [lindex $value 0]
		  foreach pin [lrange $cktval 0 end-1] {
		     set pinstr [string map {"\\" "\\\\"} $pin]
		     puts $fjson "        \"$pinstr\","
		  }
		  set pin [string map {"\\" "\\\\"} [lindex $cktval end]]
		  puts $fjson "        \"$pin\""
	          puts $fjson "      \], \["
		  set cktval [lindex $value 1]
		  foreach pin [lrange $cktval 0 end-1] {
		     set pinstr [string map {"\\" "\\\\"} $pin]
		     puts $fjson "        \"$pinstr\","
		  }
		  set pin [string map {"\\" "\\\\"} [lindex $cktval end]]
		  puts $fjson "        \"$pin\""
	          puts $fjson "      \]"
		  if {$kidx == $nkeys} {
		     puts $fjson "   \]"
		  } else {
		     puts $fjson "   \],"
		  }
	       }
               nets {
	          puts $fjson "   \"${key}\": \["
		  set cktval [lindex $value 0]
		  puts $fjson "    $cktval,"
		  set cktval [lindex $value 1]
		  puts $fjson "    $cktval"
		  if {$kidx == $nkeys} {
		     puts $fjson "   \]"
		  } else {
		     puts $fjson "   \],"
		  }
               }
	       devices {
	          puts $fjson "   \"${key}\": \["
	          puts $fjson "       \["
		  set cktval [lindex $value 0]
		  foreach dev [lrange $cktval 0 end-1] {
		     set devname [string map {"\\" "\\\\"} [lindex $dev 0]]
		     set devnum  [lindex $dev 1]
		     puts $fjson "         \[\"${devname}\", ${devnum}\],"
		  }
		  set dev [lindex $cktval end]
		  set devname [string map {"\\" "\\\\"} [lindex $dev 0]]
		  set devnum  [lindex $dev 1]
		  puts $fjson "         \[\"${devname}\", ${devnum} \]"
	          puts $fjson "       \], \["
		  set cktval [lindex $value 1]
		  foreach dev [lrange $cktval 0 end-1] {
		     set devname [string map {"\\" "\\\\"} [lindex $dev 0]]
		     set devnum  [lindex $dev 1]
		     puts $fjson "         \[\"${devname}\", ${devnum} \],"
		  }
		  set dev [lindex $cktval end]
		  set devname [string map {"\\" "\\\\"} [lindex $dev 0]]
		  set devnum  [lindex $dev 1]
		  puts $fjson "         \[\"${devname}\", ${devnum} \]"
	          puts $fjson "       \]"
		  if {$kidx == $nkeys} {
		     puts $fjson "   \]"
		  } else {
		     puts $fjson "   \],"
		  }
	       }
	       goodnets -
	       badnets {
	          puts $fjson "   \"${key}\": \["
		  set glen [llength $value]
		  set gidx 0
		  foreach group $value {
		     incr gidx
	             puts $fjson "      \["
	             puts $fjson "        \["
		     set cktval [lindex $group 0]
		     set nlen [llength $cktval]
		     set nidx 0
		     foreach net $cktval {
			incr nidx
	                puts $fjson "          \["
			set netname [string map {"\\" "\\\\"} [lindex $net 0]]
		        puts $fjson "            \"$netname\","
		        puts $fjson "            \["
			set netconn [lindex $net 1]
			foreach fanout [lrange $netconn 0 end-1] {
			   set devname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			   set pinname [string map {"\\" "\\\\"} [lindex $fanout 1]]
			   set count [lindex $fanout 2]
			   if {$count == {}} {set count 0}
		           puts $fjson "              \[ \"$devname\", \"$pinname\", $count \],"
			}
			set fanout [lindex $netconn end]
			set devname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			set pinname [string map {"\\" "\\\\"} [lindex $fanout 1]]
			set count [lindex $fanout 2]
			if {$count == {}} {set count 0}
		        puts $fjson "              \[ \"$devname\", \"$pinname\", $count \]"
		        puts $fjson "            \]"
			if {$nidx == $nlen} {
	                   puts $fjson "          \]"
			} else {
	                   puts $fjson "          \],"
			}
		     }
	             puts $fjson "        \], \["
		     set cktval [lindex $group 1]
		     set nlen [llength $cktval]
		     set nidx 0
		     foreach net $cktval {
			incr nidx
	                puts $fjson "          \["
			set netname [string map {"\\" "\\\\"} [lindex $net 0]]
		        puts $fjson "            \"$netname\","
		        puts $fjson "            \["
			set netconn [lindex $net 1]
			foreach fanout [lrange $netconn 0 end-1] {
			   set devname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			   set pinname [string map {"\\" "\\\\"} [lindex $fanout 1]]
			   set count [lindex $fanout 2]
			   if {$count == {}} {set count 0}
		           puts $fjson "              \[ \"$devname\", \"$pinname\", $count \],"
			}
			set fanout [lindex $netconn end]
			set devname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			set pinname [string map {"\\" "\\\\"} [lindex $fanout 1]]
			set count [lindex $fanout 2]
			if {$count == {}} {set count 0}
		        puts $fjson "              \[ \"$devname\", \"$pinname\", $count \]"
		        puts $fjson "            \]"
			if {$nidx == $nlen} {
	                   puts $fjson "          \]"
			} else {
	                   puts $fjson "          \],"
			}
		     }
	             puts $fjson "        \]"
		     if {$gidx == $glen} {
	                puts $fjson "      \]"
		     } else {
	                puts $fjson "      \],"
		     }
		  }
		  if {$kidx == $nkeys} {
		     puts $fjson "   \]"
		  } else {
		     puts $fjson "   \],"
		  }
	       }
	       goodelements -
	       badelements {
	          puts $fjson "   \"${key}\": \["
		  set glen [llength $value]
		  set gidx 0
		  foreach group $value {
		     incr gidx
	             puts $fjson "      \["
	             puts $fjson "        \["
		     set cktval [lindex $group 0]
		     set ilen [llength $cktval]
		     set iidx 0
		     foreach inst $cktval {
			incr iidx
	                puts $fjson "          \["
			set instname [string map {"\\" "\\\\"} [lindex $inst 0]]
		        puts $fjson "            \"$instname\","
		        puts $fjson "            \["
			set instpins [lindex $inst 1]
			foreach fanout [lrange $instpins 0 end-1] {
			   set pinname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			   set count [lindex $fanout 1]
			   if {$count == {}} {set count 0}
		           puts $fjson "              \[ \"$pinname\", $count \],"
			}
			set fanout [lindex $instpins end]
			set pinname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			set count [lindex $fanout 1]
			if {$count == {}} {set count 0}
		        puts $fjson "              \[ \"$pinname\", $count \]"
		        puts $fjson "            \]"
			if {$iidx == $ilen} {
	                   puts $fjson "          \]"
			} else {
	                   puts $fjson "          \],"
			}
		     }
	             puts $fjson "        \], \["
		     set cktval [lindex $group 1]
		     set ilen [llength $cktval]
		     set iidx 0
		     foreach inst $cktval {
			incr iidx
	                puts $fjson "          \["
			set instname [string map {"\\" "\\\\"} [lindex $inst 0]]
		        puts $fjson "            \"$instname\","
		        puts $fjson "            \["
			set instpins [lindex $inst 1]
			foreach fanout [lrange $instpins 0 end-1] {
			   set pinname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			   set count [lindex $fanout 1]
			   if {$count == {}} {set count 0}
		           puts $fjson "              \[ \"$pinname\", $count \],"
			}
			set fanout [lindex $instpins end]
			set pinname [string map {"\\" "\\\\"} [lindex $fanout 0]]
			set count [lindex $fanout 1]
			if {$count == {}} {set count 0}
		        puts $fjson "              \[ \"$pinname\", $count \]"
		        puts $fjson "            \]"
			if {$iidx == $ilen} {
	                   puts $fjson "          \]"
			} else {
	                   puts $fjson "          \],"
			}
		     }
	             puts $fjson "        \]"
		     if {$gidx == $glen} {
	                puts $fjson "      \]"
		     } else {
	                puts $fjson "      \],"
		     }
		  }
		  if {$kidx == $nkeys} {
		     puts $fjson "   \]"
		  } else {
		     puts $fjson "   \],"
		  }
	       }
	       properties {
	          puts $fjson "   \"${key}\": \["
		  set plen [llength $value]
                  set pidx 0
		  foreach instance $value {
		     incr pidx
	             puts $fjson "      \["
		     set instnames [string map {"\\" "\\\\"} [lindex $instance 0]]
		     set instname0 [string map {"\\" "\\\\"} [lindex $instnames 0]]
	             puts $fjson "         \["
		     puts $fjson "           \"${instname0}\","
	             puts $fjson "           \["
		     foreach property [lrange $instance 1 end-1] {
		        set prop0 [lindex $property 0]
			set propname [lindex $prop0 0]
			set propval [lindex $prop0 1]
		        puts $fjson "             \[\"${propname}\", \"${propval}\"\],"
		     }
		     set property [lindex $instance end]
		     set prop0 [lindex $property 0]
		     set propname [lindex $prop0 0]
		     set propval [lindex $prop0 1]
		     puts $fjson "             \[\"${propname}\", \"${propval}\"\]"
	             puts $fjson "           \]"
	             puts $fjson "         \],"
		     set instname1 [string map {"\\" "\\\\"} [lindex $instnames 1]]
	             puts $fjson "         \["
		     puts $fjson "           \"${instname1}\","
	             puts $fjson "           \["
		     foreach property [lrange $instance 1 end-1] {
		        set prop1 [lindex $property 1]
			set propname [lindex $prop1 0]
			set propval [lindex $prop1 1]
		        puts $fjson "             \[\"${propname}\", \"${propval}\"\],"
		     }
		     set property [lindex $instance end]
		     set prop1 [lindex $property 1]
		     set propname [lindex $prop1 0]
		     set propval [lindex $prop1 1]
		     puts $fjson "             \[\"${propname}\", \"${propval}\"\]"
	             puts $fjson "           \]"
	             puts $fjson "         \]"
		     if {$pidx == $plen} {
	                puts $fjson "      \]"
		     } else {
	                puts $fjson "      \],"
		     }
		  }
		  if {$kidx == $nkeys} {
		     puts $fjson "   \]"
		  } else {
		     puts $fjson "   \],"
		  }
	       }
	    }
	 }
         if {$cidx == $clen} {
            puts $fjson "  \}"
	 } else {
            puts $fjson "  \},"
	 }
      }
      puts $fjson "\]"
   }
   close $fjson
}

#-----------------------------------------------------------------------
# Define the "lvs" command as a way of calling the netgen options
# for standard compare, essentially the same as the old "netcomp"
# standalone program.
#
# Use the "canonical" command to parse the file and cell names,
# although if the cells have not been read in yet, then the
# original syntax of filename or {filename cellname} is required.
#
# "args" may be "-list", "-json", or "-blackbox".
#    "-list" returns output as a nested list.
#    "-json" creates a .json-format output file in addition to stdout.
#    "-blackbox" treats empty cells as black-box entries.
#    "-noflatten={list}" is a list of cells not to flatten if mismatched.
#    i.e., the cells are expected to match and any mismatch cannot be
#    expected to be resolved by flattening the contents of the mismatched
#    cells.
#-----------------------------------------------------------------------

proc netgen::lvs { name1 name2 {setupfile setup.tcl} {logfile comp.out} args} {
   set dolist 0
   set dojson 0
   set noflat {}
   foreach arg $args {
      if {$arg == "-list"} {
	 puts stdout "Generating list result"
	 set dolist 1
	 set lvs_final {}
      } elseif {$arg == "-json"} {
	 puts stdout "Generating JSON file result"
	 set dolist 1
	 set dojson 1
	 set lvs_final {}
      } elseif {$arg == "-blackbox"} {
	 puts stdout "Treating empty subcircuits as black-box cells"
	 netgen::model blackbox on
      } elseif {[string first "-noflatten=" $arg] == 0} {
	 set value [string range $arg 11 end]
	 # If argument is a filename then read the list of cells from it;
	 # otherwise, argument is the list of files itself in quotes or
	 # braces.
	 if {[file exists $value]} {
	    if {![catch {open $value r} fnf]} {
	       while {[gets $fnf line] >= 0} {
		  if {[lindex $line 0] != "#"} {
		     foreach cell $line {
		    	lappend noflat $cell
		     }
		  }
	       }
	       close $fnf
	    } else {
	       puts stderr "Cannot open file $value for reading cell list."
	    }
	 } else {
	    set noflat [string trim $value \"\{\}]
	 }
	 if {[llength $noflat] > 0} {
	    puts stdout "Will not flatten these subcells: $noflat"
	 }
      }
   }

   # Allow name1 or name2 to be a list of {filename cellname},
   # A single <filename>, or any valid_cellname form if the
   # file has already been read.

   if {[catch {set flist1 [canonical $name1]}]} {
      if {[llength $name1] == 2} {
         set file1 [lindex $name1 0]
         set cell1 [lindex $name1 1]
      } else {
         set file1 $name1
         set cell1 $name1
      }
      puts stdout "Reading netlist file $file1 for $name1"
      set fnum1 [netgen::readnet $file1]
   } else {
      set cell1 [lindex $flist1 0]
      set fnum1 [lindex $flist1 1]
      set flist1 [canonical $fnum1]
      set file1 [lindex $flist1 0]
   }

   if {[catch {set flist2 [canonical $name2]}]} {
      if {[llength $name2] == 2} {
         set file2 [lindex $name2 0]
         set cell2 [lindex $name2 1]
      } else {
         set file2 $name2
         set cell2 $name2
      }
      puts stdout "Reading netlist file $file2 for $name2"
      set fnum2 [netgen::readnet $file2]
   } else {
      set cell2 [lindex $flist2 0]
      set fnum2 [lindex $flist2 1]
      set flist2 [canonical $fnum2]
      set file2 [lindex $flist2 0]
   }

   if {$fnum1 == $fnum2} {
      puts stderr "Both cells are in the same netlist:  Cannot compare!"
      return
   }

   set clist1 [cells list $fnum1]
   set cidx [lsearch -exact $clist1 $cell1]
   if {$cidx < 0} {
      puts stderr "Cannot find cell $cell1 in file $file1"
      return
   } else {
      set cell1 [lindex $clist1 $cidx]
   }
   set clist2 [cells list $fnum2]
   set cidx [lsearch -exact $clist2 $cell2]
   if {$cidx < 0} {
      puts stderr "Cannot find cell $cell2 in file $file2"
      return
   } else {
      set cell2 [lindex $clist2 $cidx]
   }

   # The "noflat" list is non-file-specific, so run on each file.
   foreach cell $noflat {
      set cidx [lsearch -regexp $clist1 ^$cell$]
      if {$cidx >= 0} {
          netgen::flatten prohibit "$fnum1 $cell"
      }
      set cidx [lsearch -regexp $clist2 ^$cell$]
      if {$cidx >= 0} {
          netgen::flatten prohibit "$fnum2 $cell"
      }
   }

   # Resolve parameters passed to subcircuits.  A subcircuit that is
   # instanced with more than one set of parameters is copied, one copy
   # for each set;  the copies are listed in the log file (see below).
   set elab1 [netgen::elaborate $fnum1]
   set elab2 [netgen::elaborate $fnum2]

   netgen::compare assign "$fnum1 $cell1" "$fnum2 $cell2"

   if {$setupfile == ""} {
      puts stdout "\nNo setup file specified.  Using trivial default setup.\n"
      netgen::permute default	;# transistors and resistors
      netgen::property default
   } elseif {[file exists $setupfile]} {
      puts stdout "\nReading setup file $setupfile\n"
      # Instead of sourcing the setup file, run each line so we can
      # catch individual errors and not let them halt the LVS process
      set perrors 0
      if {![catch {open $setupfile r} fsetup]} {
	 set sline 0
	 set command {}
	 while {[gets $fsetup line] >= 0} {
	    incr sline
	    append command $line "\n"
	    if {[info complete $command]} {
	       if {[catch {uplevel 1 [list namespace eval netgen $command]} msg]} {
		  set msg [string trimright $msg "\n"]
		  puts stderr "Error $setupfile:$sline (ignoring), $msg"
		  incr perrors
	       }
	       set command {}
	    }
	 }
	 close $fsetup
      	 if {$command != {}} {
	    # Incomplete command.  Evaluate it to get a meaningful error message
	    if {[catch {uplevel 1 [list namespace eval netgen $command]} msg]} {
		set msg [string trimright $msg "\n"]
		puts stderr "Error $setupfile:$sline (ignoring), $msg"
		incr perrors
	    }
	 }
      } else {
	 puts stdout "Error:  Cannot read the setup file $setupfile"
      }
	
      if {$perrors > 0} {
	 puts stdout "Warning:  There were errors reading the setup file"
      }
   } elseif {[string first nosetup $setupfile] < 0} {
      puts stderr "\nError:  Setup file $setupfile does not exist.\n"
      return
   } else {
      puts stderr "\nNo setup file specified.  Continuing without a setup.\n"
   }

   if {[string first nolog $logfile] < 0} {
      puts stdout "Comparison output logged to file $logfile"
      netgen::log file $logfile

      netgen::log start
      netgen::log echo off
      set dolog true
   } else {
      set dolog false
   }

   if {$elab1 != {} || $elab2 != {}} {
      set elabmsg "\nSubcircuits instanced with more than one set of parameters\n"
      append elabmsg "were copied, one copy for each set:\n"
      foreach elab $elab1 {
	 append elabmsg "  Circuit ($fnum1): [lindex $elab 1]:  [lindex $elab 2]\n"
      }
      foreach elab $elab2 {
	 append elabmsg "  Circuit ($fnum2): [lindex $elab 1]:  [lindex $elab 2]\n"
      }
      netgen::log put $elabmsg
   }

   if {$dolist == 1} {
      set endval [netgen::compare -list hierarchical "$fnum1 $cell1" "$fnum2 $cell2"]
   } else {
      set endval [netgen::compare hierarchical "$fnum1 $cell1" "$fnum2 $cell2"]
   }
   if {$endval == {}} {
      netgen::log put "No cells in queue!\n"
      return
   }
   set properr {}
   set matcherr {}
   set bboxerr1 {}		;# black-boxed cells with contents in circuit 1
   set bboxerr2 {}		;# black-boxed cells with contents in circuit 2
   set childMismatch 0		;# 1 indicates black-box child subcircuit mismatch
   while {$endval != {}} {
      if {$dolist == 1} {
         netgen::run -list converge
      } else {
         netgen::run converge
      }
      set pinMismatch 0		;# indicates pin mismatch in top cell
      set netMismatch 0		;# indicates netlist (topology) mismatch in top cell
      set doCheckFlatten 0
      set doFlatten 0
      if {[netgen::print queue] == {}} {
	 set doEquatePins 1 	;# run equate pins on top cell
      } else {
	 set doEquatePins 0	;# don't run equate pins unless unique match
      }
      set forceMatch 0		;# for pin matching
      netgen::log echo off

      if {[verify equivalent]} {
	 # Resolve automorphisms by pin and property
	 if {$dolist == 1} {
            netgen::run -list resolve
	 } else {
            netgen::run resolve
	 }
	 set uresult [verify unique]
	 # uresult:  -3 : unique with property error
	 #	     -2 : equivalent with port errors
	 #	     -1 : black box
	 #	      0 : equivalent but not unique
	 #	      1 : unique
         if {$uresult == 0} {
	    netgen::log echo on
	    netgen::log put "   Networks match locally but not globally.\n"
	    netgen::log put "   Probably connections are swapped.\n"
	    netgen::log put "   Check the end of logfile ${logfile} for implicated nodes.\n"
	    netgen::log echo off
	    if {$dolist == 1} {
	       verify -list nodes
	    } else {
	       verify nodes
	    }
	    set doCheckFlatten 1
	 } else {
	    # Equate pins for black boxes, unique matches (possibly with property
	    # errors), and unique with port errors
	    set doEquatePins 1
	 }
	 if {$uresult == -1} {		;# black box
	    set forceMatch 1
	    # If one side has contents, those contents were not compared.
	    # Keep track of these for the final summary.
	    if {[netgen::contents -check "$fnum1 [lindex $endval 0]"]} {
	       lappend bboxerr1 [lindex $endval 0]
	    }
	    if {[netgen::contents -check "$fnum2 [lindex $endval 1]"]} {
	       lappend bboxerr2 [lindex $endval 1]
	    }
	 } elseif {$uresult == -3} {	;# property error
	    lappend properr [lindex $endval 0]
	 } elseif {$uresult == -2} {	;# unmatched pins
	    set doCheckFlatten 1
	 } elseif {$uresult == -4} {	;# unmatched pins and properties
	    lappend properr [lindex $endval 0]
	    set doCheckFlatten 1
	 }
      } else {
	 # not equivalent
	 netgen::log echo on
	 # netgen::log put "  DEBUG: not equivalent $endval\n"
	 netgen::log echo off
	 set doCheckFlatten 1
	 set netMismatch 1
      }
      if {$doCheckFlatten} {
	 # Flatten the non-matching subcircuit (but not the top-level cell,
	 # or cells explicitly prohibited from flattening)
	 if {[netgen::print queue] != {}} {
	    if {([lsearch $noflat [lindex $endval 0]] == -1) &&
			([lsearch $noflat [lindex $endval 1]] == -1)} {
	       set doFlatten 1
	    } else {	
	       netgen::log echo on
	       netgen::log put "  Continuing with black-boxed subcircuits $endval\n"
	       netgen::log echo off
	       lappend matcherr "[lindex $endval 0]($fnum1)"
	       lappend matcherr "[lindex $endval 1]($fnum2)"
	       netgen::flatten prohibit "[lindex $endval 0] $fnum1"
	       netgen::flatten prohibit "[lindex $endval 1] $fnum2"
	       set doEquatePins 1
	       set childMismatch 1
	       set forceMatch 1
	    }
	 }
      }
      if {$doEquatePins} {
	 # Match pins
	 if {$dolist == 1} {
	    if {$forceMatch} {
	       set result [equate -list -force pins "$fnum1 [lindex $endval 0]" \
				"$fnum2 [lindex $endval 1]"]
	    } else {
	       set result [equate -list pins "$fnum1 [lindex $endval 0]" \
				"$fnum2 [lindex $endval 1]"]
	    }
	 } else {
	    if {$forceMatch} {
	       set result [equate -force pins "$fnum1 [lindex $endval 0]" \
				"$fnum2 [lindex $endval 1]"]
	    } else {
	       set result [equate pins "$fnum1 [lindex $endval 0]" \
				"$fnum2 [lindex $endval 1]"]
	    }
	 }
	 # A black box has nothing to compare but its pins, so if its pins
	 # do not all match by name, it is a subcell that failed to match.
	 if {$forceMatch && $result == 0 && [netgen::print queue] != {}} {
	    if {[lsearch -exact $matcherr "[lindex $endval 0]($fnum1)"] < 0} {
	       lappend matcherr "[lindex $endval 0]($fnum1)"
	       lappend matcherr "[lindex $endval 1]($fnum2)"
	    }
	    set childMismatch 1
	 }

	 # Do not equate classes for a top level cell that failed to match
	 # topologically.  (Non-matching subcells that are black-boxed must
	 # still be equated so that the parent cell can be compared.)
	 if {$result >= 0 && !($netMismatch && [netgen::print queue] == {})} {
	    equate classes "$fnum1 [lindex $endval 0]" \
		        "$fnum2 [lindex $endval 1]"
	 }
	 # Do not set pinMismatch for black boxes
	 if {$result < 0} {
	    if {$result == -1 && [netgen::print queue] != {} && $forceMatch != 1} {
               # flatten pin mismatch, but not empty cells (-2) or top cell or
	       # cells prohibited from flattening.
	       set doFlatten 1
	    }
	 } elseif {[netgen::print queue] == {} && $result == 0} {
	    set pinMismatch 1
	 } else {
	    # This assumes that proxy pins are added correctly.  Previously,
	    # that was not trusted, and so an initial pin mismatch would
	    # always force subcells to be flattened.
	    set doFlatten 0
	 }
      }
      if {$doFlatten} {
	 netgen::log echo on
	 netgen::log put "  Flattening non-matched subcircuits $endval\n"
	 netgen::log echo off
	 netgen::flatten class "[lindex $endval 0] $fnum1"
	 netgen::flatten class "[lindex $endval 1] $fnum2"
      }

      if {$dolist == 1} {
         catch {lappend lvs_final $lvs_out}
         set lvs_out {}
         set endval [netgen::compare -list hierarchical]
      } else {
         set endval [netgen::compare hierarchical]
      }
   }
   netgen::log echo on
   # Report black-boxed cells before the final result, so that scripts
   # parsing the end of the output are not affected.  Use a single
   # "log put" because each call adds a newline on the console.
   if {$bboxerr1 != {} || $bboxerr2 != {}} {
      set bboxmsg "\nThe following subcircuits were treated as black boxes,\n"
      append bboxmsg "and their contents were not compared:\n"
      if {$bboxerr1 != {}} {
	 append bboxmsg "  Circuit ($fnum1): [join $bboxerr1 { }]\n"
      }
      if {$bboxerr2 != {}} {
	 append bboxmsg "  Circuit ($fnum2): [join $bboxerr2 { }]\n"
      }
      netgen::log put $bboxmsg
   }
   netgen::log put "\nFinal result: "
   if {$netMismatch} {
      # The top level failed to match topologically.  Report that
      # result;  any pin mismatch is a consequence of it and is not
      # meaningful on its own.
      verify only
      if {$childMismatch} {
	 netgen::log put "Subcell(s) failed matching.\n"
      }
   } elseif {$pinMismatch || $childMismatch} {
      if {$childMismatch} {
	 netgen::log put "Subcell(s) failed matching.\n"
      }
      if {$pinMismatch} {
	 netgen::log put "Top level cell failed pin matching.\n"
      }
   } else {
      verify only
   }
   if {$properr != {}} {
      netgen::log put "\nThe following cells had property errors:\n " [regsub -all { } $properr "\n "] "\n"
   }
   if {$matcherr != {}} {
      netgen::log put "\nThe following subcells failed to match:\n " [regsub -all { } $matcherr "\n "] "\n"
   }
   if {$dolog} {
      netgen::log end
   }
   puts stdout "LVS Done."
   if {$dojson == 1} {
      netgen::convert_to_json $logfile $lvs_final
   } elseif {$dolist == 1} {
      return $lvs_final
   }
}

#-----------------------------------------------------------------------
# Use yosys to elaborate a verilog module into a simple structural
# netlist that netgen's own verilog reader can read:  generate loops are
# unrolled, conditions on parameters are evaluated, and so forth.  This
# needs yosys version 0.67 or newer, which has the "slang" verilog
# front end (command "read_slang") built in.
#
# Usage:
#    netgen::yosys_elaborate files module ?options?
#
#    files	verilog source file(s) containing the module
#    module	name of the module to elaborate
#
# Options:
#    -param {name value ...}	parameter values for the module
#    -define {name[=value] ...}	macro definitions.  "LVS" is always
#				defined, as it is by netgen's verilog
#				reader.
#    -stubs {file ...}		verilog file(s) defining the cells that the
#				module instantiates as black boxes:
#				"(* blackbox *) module name (pins); ..."
#				Every cell must be defined, either here or
#				in the source files.
#    -include {dir ...}		directories to search for `include files
#				(in addition to those of the source files)
#    -output file		name of the output file (by default, a file
#				in a temporary directory)
#    -frontend auto|slang|verilog
#				"slang" uses read_slang;  "verilog" uses
#				yosys's own reader (read_verilog -sv),
#				which cannot set parameters to real values;
#				"auto" (the default) uses read_slang, and
#				if that fails, read_verilog -sv.
#    -cells {{name {pin ...} {param ...}} ...}
#				cells known to netgen (this is how netgen
#				calls this procedure when elaborating a
#				netlist).  The module is elaborated by one
#				level only:  the other modules defined in
#				the source files are black boxes, and stubs
#				are written for the cells that are not.
#
# Returns the name of the output file, or an empty string if yosys is
# not available or fails (the reason is printed).  The output file
# defines the module (with the same name).  Without -cells, it also
# defines any modules it instantiates that are defined in the source
# files (with names made unique by yosys, such as
# "child$module.instance"), but not the stubs.
#
# Variables:
#    netgen::yosys_command	the yosys command (default "yosys")
#    netgen::yosys_use		set to 0 to not use yosys at all;  verilog
#				modules that netgen cannot read are then
#				treated as black boxes
#    netgen::yosys_defines	macro definitions always passed to yosys
#				(e.g., "USE_POWER_PINS")
#-----------------------------------------------------------------------

namespace eval netgen {
   variable yosys_command yosys
   variable yosys_use 1
   variable yosys_defines {}
   variable yosys_ok {}
   variable yosys_count 0
   variable yosys_tmpdir {}
}

# Check (once) if yosys can be used.  Returns 1 if so, 0 if not.

proc netgen::yosys_check {} {
   variable yosys_command
   variable yosys_use
   variable yosys_ok

   if {!$yosys_use} {
      puts stderr "Use of yosys is disabled (netgen::yosys_use is 0)."
      return 0
   }
   if {$yosys_ok != {}} {return $yosys_ok}
   set yosys_ok 0
   set yosys [auto_execok $yosys_command]
   if {$yosys == {}} {
      puts stderr "Cannot find yosys (\"$yosys_command\")."
      return 0
   }
   if {[catch {exec {*}$yosys -V} vers]} {
      puts stderr "Cannot run yosys (\"$yosys_command\"):  $vers"
      return 0
   }
   if {![regexp {Yosys ([0-9]+)\.([0-9]+)} $vers -> major minor]} {
      puts stderr "Cannot determine the version of yosys from \"$vers\"."
      return 0
   }
   if {($major == 0) && ($minor < 67)} {
      puts stderr "Yosys version $major.$minor is too old;  version 0.67\
		or newer is needed."
      return 0
   }
   if {[catch {exec {*}$yosys -p "help read_slang" 2>@1} help] ||
		![regexp {read_slang \[options\]} $help]} {
      puts stderr "Yosys version $major.$minor does not have the\
		\"read_slang\" command."
      return 0
   }
   set yosys_ok 1
   return 1
}

# Return a verilog identifier for "name":  the name itself, or an escaped
# identifier ("\\name ") if it is not a simple identifier or is a keyword.

proc netgen::yosys_ident {name} {
   if {[string index $name 0] == "\\"} {
      return "[string trimright $name] "
   }
   if {[regexp {^[A-Za-z_][A-Za-z0-9_$]*$} $name] && [lsearch -exact {always
		and assign begin buf case default else end endcase endmodule
		for if initial inout input integer module nand nor not or
		output parameter real reg supply0 supply1 tri wire xor} $name] < 0} {
      return $name
   }
   return "\\$name "
}

# Return the names of the modules defined in verilog files, without any
# escape character.

proc netgen::yosys_modules {files} {
   set names {}
   foreach f $files {
      if {[catch {open $f r} fl]} continue
      set text [read $fl]
      close $fl
      regsub -all {/\*.*?\*/} $text " " text
      regsub -all {//[^\n]*} $text " " text
      foreach {all name} [regexp -all -inline \
		{(?:^|[\s;])(?:macro)?module\s+(\\\S+|[A-Za-z_][A-Za-z0-9_$]*)} $text] {
	 lappend names [string trim $name "\\ "]
      }
   }
   return $names
}

# Write black-box definitions ("stubs") of cells to file "fname", for
# yosys.  "cells" is a list of {name {pin ...} {param ...}}.  Bus pins
# ("a[3]" or "a<3>") are written as vectors ("a[3:0]").  Every pin is
# "inout", and every parameter has the default value 0 (yosys only needs
# to know that they exist).

proc netgen::yosys_write_stubs {fname cells} {
   set fs [open $fname w]
   puts $fs "// Black-box definitions of cells, written by netgen for yosys"
   foreach cell $cells {
      lassign $cell name pins params
      set bases {}
      foreach pin $pins {
	 if {[regexp {^(.+)[\[<]([0-9]+)[\]>]$} $pin -> base idx]} {
	    if {[dict exists $bases $base]} {
	       lassign [dict get $bases $base] lo hi
	       if {$lo == {}} {
		  # Same name as a pin that is not a bus:  write separately
		  dict set bases $pin {{} {}}
		  continue
	       }
	       if {$idx < $lo} {set lo $idx}
	       if {$idx > $hi} {set hi $idx}
	       dict set bases $base [list $lo $hi]
	    } else {
	       dict set bases $base [list $idx $idx]
	    }
	 } elseif {![dict exists $bases $pin]} {
	    dict set bases $pin {{} {}}
	 }
      }
      set plist {}
      set decls {}
      dict for {base range} $bases {
	 set id [netgen::yosys_ident $base]
	 lappend plist $id
	 lassign $range lo hi
	 if {$lo == {}} {
	    lappend decls "   inout $id;"
	 } else {
	    lappend decls "   inout \[$hi:$lo\] $id;"
	 }
      }
      set pdecls {}
      foreach param $params {
	 if {[regexp {^[A-Za-z_][A-Za-z0-9_$]*$} $param] &&
		[lsearch -exact $pdecls "parameter $param = 0"] < 0} {
	    lappend pdecls "parameter $param = 0"
	 }
      }
      set header "module [netgen::yosys_ident $name]"
      if {$pdecls != {}} {append header " #([join $pdecls ", "])"}
      if {$plist != {}} {append header " ([join $plist ", "])"}
      puts $fs "(* blackbox *)"
      puts $fs "$header;"
      foreach d $decls {puts $fs $d}
      puts $fs "endmodule"
   }
   close $fs
}

# Return the index of the parenthesis that closes the one at index "start"
# of "text", or -1 if there is none.

proc netgen::yosys_close_paren {text start} {
   set depth 0
   set n [string length $text]
   for {set i $start} {$i < $n} {incr i} {
      switch -- [string index $text $i] {
	 "(" {incr depth}
	 ")" {
	    incr depth -1
	    if {$depth == 0} {return $i}
	 }
      }
   }
   return -1
}

# For cells that are instanced in verilog files but not defined anywhere,
# find their pin names (and parameter names) from the instances, which
# connect pins by name (".pin(net)"), in the same way that netgen makes
# placeholder cells for them.  Returns a list of cells in the form used by
# netgen::yosys_write_stubs.  A cell whose instances connect pins by
# position is left out.

proc netgen::yosys_guess_cells {files names} {
   set text {}
   foreach f $files {
      if {[catch {open $f r} fl]} continue
      append text [read $fl] "\n"
      close $fl
   }
   regsub -all {/\*.*?\*/} $text " " text
   regsub -all {//[^\n]*} $text " " text

   set cells {}
   foreach name $names {
      set pins {}
      set params {}
      set found 0
      set ok 1
      regsub -all {[$]} $name {\\$} rname
      foreach match [regexp -all -indices -inline "\\m${rname}(?!\[A-Za-z0-9_\$\])" $text] {
	 set pos [expr {[lindex $match 1] + 1}]
	 set rest [string range $text $pos end]
	 # Parameters:  "#( .name(value), ... )"
	 if {[regexp -indices {^\s*#\s*\(} $rest pidx]} {
	    set open [expr {$pos + [lindex $pidx 1]}]
	    set close [netgen::yosys_close_paren $text $open]
	    if {$close < 0} continue
	    foreach {all p} [regexp -all -inline {\.\s*([A-Za-z_][A-Za-z0-9_$]*)\s*\(} \
			[string range $text $open $close]] {
	       if {[lsearch -exact $params $p] < 0} {lappend params $p}
	    }
	    set pos [expr {$close + 1}]
	    set rest [string range $text $pos end]
	 }
	 # Instance name, optional array range, and pin list
	 if {![regexp -indices {^\s*(?:\\\S+|[A-Za-z_][A-Za-z0-9_$]*)\s*(?:\[[^\]]*\])?\s*\(} \
			$rest iidx]} continue
	 set open [expr {$pos + [lindex $iidx 1]}]
	 set close [netgen::yosys_close_paren $text $open]
	 if {$close < 0} continue
	 set plist [string range $text [expr {$open + 1}] [expr {$close - 1}]]
	 set found 1
	 if {[string trim $plist] == {}} continue
	 set named [regexp -all -inline {\.\s*(\\\S+|[A-Za-z_][A-Za-z0-9_$]*)\s*\(} $plist]
	 if {$named == {}} {
	    set ok 0	;# Pins connected by position
	    break
	 }
	 foreach {all p} $named {
	    if {[lsearch -exact $pins $p] < 0} {lappend pins $p}
	 }
      }
      if {$found && $ok} {lappend cells [list $name $pins $params]}
   }
   return $cells
}

proc netgen::yosys_elaborate {files module args} {
   variable yosys_command
   variable yosys_defines
   variable yosys_count
   variable yosys_tmpdir

   set params {}
   set defines $yosys_defines
   set stubs {}
   set incdirs {}
   set output {}
   set frontend auto
   set cells {}
   set havecells 0

   foreach {opt val} $args {
      switch -- $opt {
	 -param    {set params $val}
	 -define   {lappend defines {*}$val}
	 -stubs    {set stubs $val}
	 -include  {set incdirs $val}
	 -output   {set output $val}
	 -cells    {set cells $val; set havecells 1}
	 -frontend {
	    if {[lsearch -exact {auto slang verilog} $val] < 0} {
	       error "Bad frontend \"$val\":  must be auto, slang, or verilog."
	    }
	    set frontend $val
	 }
	 default {
	    error "Unknown option \"$opt\":  must be -param, -define,\
			-stubs, -include, -output, -frontend, or -cells."
	 }
      }
   }
   if {[llength $params] % 2 != 0} {
      error "Parameter list \"$params\" must be pairs of name and value."
   }
   # "LVS" is always defined, as it is by netgen's verilog reader
   set hasLVS 0
   foreach d $defines {
      if {[regexp {^LVS(=.*)?$} $d]} {set hasLVS 1}
   }
   if {!$hasLVS} {lappend defines LVS}

   if {![netgen::yosys_check]} {return {}}
   set yosys [auto_execok $yosys_command]

   # Yosys script arguments cannot be quoted, so names cannot contain
   # white space.
   foreach f [concat $files $stubs $incdirs $output] {
      if {[regexp {\s} $f]} {
	 puts stderr "Cannot use yosys with file name \"$f\" (contains spaces)."
	 return {}
      }
   }
   foreach f [concat $files $stubs] {
      if {![file readable $f]} {
	 puts stderr "Cannot read file \"$f\"."
	 return {}
      }
   }
   foreach f $files {
      set d [file dirname [file normalize $f]]
      if {[lsearch -exact $incdirs $d] < 0} {lappend incdirs $d}
   }

   # Temporary directory for scripts, logs, and output
   if {$yosys_tmpdir == {} || ![file isdirectory $yosys_tmpdir]} {
      if {[info exists ::env(TMPDIR)] && [file isdirectory $::env(TMPDIR)]} {
	 set tmp $::env(TMPDIR)
      } else {
	 set tmp /tmp
      }
      set yosys_tmpdir [file join $tmp netgen_yosys_[pid]]
      file mkdir $yosys_tmpdir
   }
   incr yosys_count
   regsub -all {[^A-Za-z0-9_]} $module _ mname
   set base [file join $yosys_tmpdir ${mname}_$yosys_count]
   if {$output == {}} {set output ${base}.v}

   # With -cells, the other modules defined in the source files are black
   # boxes, and stubs are written for the cells that are not defined there.
   set bboxes {}
   if {$havecells} {
      set srcmods [netgen::yosys_modules $files]
      foreach m $srcmods {
	 if {$m != [string trim $module "\\ "]} {lappend bboxes $m}
      }
      set stubcells {}
      foreach cell $cells {
	 if {[lsearch -exact $srcmods [string trim [lindex $cell 0] "\\ "]] < 0} {
	    lappend stubcells $cell
	 }
      }
      if {$stubcells != {}} {
	 set stubfile ${base}_stubs.v
	 netgen::yosys_write_stubs $stubfile $stubcells
	 lappend stubs $stubfile
      }
   }

   # Parameter values:  numbers (including verilog based constants such
   # as 32'h1f) and quoted strings are passed as they are;  anything else
   # is a string, which yosys needs in double quotes.
   set pvals {}
   set isreal 0
   foreach {name value} $params {
      set value [string trim $value]
      if {[string is integer -strict $value] ||
		[regexp {^[0-9_]*'[sS]?[bBoOdDhH][0-9a-fA-FxXzZ_?]+$} $value] ||
		[regexp {^".*"$} $value]} {
	 lappend pvals $name $value
      } elseif {[string is double -strict $value]} {
	 lappend pvals $name $value
	 set isreal 1
      } else {
	 lappend pvals $name \"$value\"
      }
   }

   if {$frontend == "auto"} {
      set frontends {slang verilog}
   } else {
      set frontends $frontend
   }
   set errors {}
   set guessed 0
   foreach fe $frontends {
      if {($fe == "verilog") && $isreal} {
	 lappend errors "read_verilog cannot set a parameter to a real value."
	 continue
      }
      # A second try is made if cells are not defined anywhere (see below).
      for {set try 0} {$try < 2} {incr try} {
	 # Note that the script lines are joined with spaces, not formed as
	 # Tcl lists, which would put braces around values with quotes.
	 set script {}
	 set opts {}
	 foreach d $defines {lappend opts "-D $d"}
	 foreach d $incdirs {lappend opts "-I $d"}
	 set srcs [join [concat $stubs $files] " "]
	 if {$fe == "slang"} {
	    foreach {name value} $pvals {lappend opts "-G ${name}=$value"}
	    foreach m $bboxes {lappend opts "--blackboxed-module $m"}
	    lappend script "read_slang [join $opts " "] --top $module $srcs"
	 } else {
	    if {$stubs != {}} {lappend script "read_verilog -lib [join $stubs " "]"}
	    lappend script "read_verilog -sv [join $opts " "] [join $files " "]"
	    if {$bboxes != {}} {lappend script "blackbox [join $bboxes " "]"}
	    if {$pvals != {}} {
	       set chp {}
	       foreach {name value} $pvals {lappend chp "-set $name $value"}
	       lappend script "chparam [join $chp " "] $module"
	    }
	 }
	 lappend script "hierarchy -top $module"
	 # Do not run any optimization:  "opt_clean" would remove cells whose
	 # outputs are not used, such as tie cells and decap cells.
	 lappend script "write_verilog -noattr $output"

	 set ys ${base}_${fe}.ys
	 set log ${base}_${fe}.log
	 set fs [open $ys w]
	 puts $fs [join $script "\n"]
	 close $fs
	 file delete -force $output
	 if {![catch {exec {*}$yosys -q -l $log -s $ys 2>@1}] &&
		   [file exists $output]} {
	    file delete -force $ys $log
	    if {[info exists stubfile]} {file delete -force $stubfile}
	    if {[info exists gfile]} {file delete -force $gfile}
	    return $output
	 }
	 # Collect the error messages from the log, and the names of any
	 # cells that are not defined.
	 set msgs {}
	 set unknown {}
	 if {![catch {open $log r} fl]} {
	    foreach line [split [read $fl] "\n"] {
	       if {[regexp {ERROR} $line]} {lappend msgs [string trim $line]}
	       if {[regexp {unknown module '([^']+)'} $line -> name] ||
			   [regexp {of unknown type `([^']+)'} $line -> name]} {
		  if {[lsearch -exact $unknown $name] < 0} {lappend unknown $name}
	       }
	    }
	    close $fl
	 }

	 # Cells that are not defined anywhere (netgen treats them as
	 # black boxes, with pins taken from the instances):  write stubs for
	 # them in the same way, and try again.
	 if {($try == 0) && !$guessed && ($unknown != {})} {
	    set gcells [netgen::yosys_guess_cells $files $unknown]
	    if {[llength $gcells] == [llength $unknown]} {
	       set gfile ${base}_undefined.v
	       netgen::yosys_write_stubs $gfile $gcells
	       lappend stubs $gfile
	       set guessed 1
	       puts stdout "Cells not defined (black boxes, pins from instances):\
			   [join $unknown {, }]"
	       continue
	    }
	 }
	 if {$msgs == {}} {set msgs "yosys failed."}
	 lappend errors "read_$fe:  [join $msgs "\n      "]\n      (see $ys and $log)"
	 break
      }
   }
   puts stderr "Yosys could not elaborate module \"$module\":"
   foreach e $errors {puts stderr "   $e"}
   return {}
}

# It is important to make sure no netgen commands overlap with Tcl built-in
# commands, because otherwise the namespace import will fail.

proc pushnamespace { name } {

   set y [namespace eval ${name} info commands ::${name}::*]
   set z [info commands]

   foreach v $y {
      regsub -all {\*} $v {\\*} i
      set x [namespace tail $i]
      if {[lsearch $z $x] < 0} {
         namespace import $i
      } else {
            puts "Warning: ${name} command '$x' use fully-qualified name '$v'"
      }
   }
}

proc popnamespace { name } {
   set z [info commands]
   set l [expr [string length ${name}] + 5]

   while {[set v [lsearch $z ${name}_tcl_*]] >= 0} {
      set y [lindex $z $v]
      set w [string range $y $l end]
      interp alias {} ::$w {}
      rename ::$y ::$w
      puts "Info: replacing ::$w with ::$y"
   }
   namespace forget ::${name}::*
}

set auto_noexec 1       ;# don't EVER call UNIX commands w/o "shell" in front

#----------------------------------------------------------------------
# Cross-Application section
#----------------------------------------------------------------------

# For use with open_pdks, set PDK_ROOT from the environment.  If no
# such environment variable exists, check some common locations.

if {[catch {set PDK_ROOT $::env(PDK_ROOT)}]} {
    if {[file isdir /usr/local/share/pdk] == 1} {
	set PDK_ROOT /usr/local/share/pdk
    } elseif {[file isdir /usr/share/pdk] == 1} {
	set PDK_ROOT /usr/share/pdk
    } elseif {[file isdir /foss/pdk] == 1} {
	set PDK_ROOT /foss/pdk
    }
}

# Setup IRSIM assuming that the Tcl version is installed.
# We do not need to rename procedure irsim to NULL because it is
# redefined in a script, which simply overwrites the original.

proc irsim { args } {
   global CAD_ROOT
   set irsimscript [glob -nocomplain ${CAD_ROOT}/irsim/tcl/irsim.tcl]
   if { ${irsimscript} == {} } {
      puts stderr "\"irsim\" requires Tcl-based IRSIM version 9.6 or newer."
      puts stderr "Could not find script \"irsim.tcl\".  If IRSIM is installed in a"
      puts stderr "place other than CAD_ROOT (=${CAD_ROOT}), use the command"
      puts stderr "\"source <path>/irsim.tcl\" before doing \"irsim\"."
   } else {
      source $irsimscript
      eval {irsim} $args
   }
}

# Setup Xcircuit assuming that the Tcl version is installed.

proc xcircuit { args } {
   global CAD_ROOT
   global argc
   global argv
   set xcircscript [glob -nocomplain ${CAD_ROOT}/xcircuit*/xcircuit.tcl]
   if { ${xcircscript} == {} } {
      puts stderr "\"xcircuit\" requires Tcl-based XCircuit version 3.1 or newer."
      puts stderr "Could not find script \"xcircuit.tcl\".  If XCircuit is installed in a"
      puts stderr "place other than CAD_ROOT (=${CAD_ROOT}), use the command"
      puts stderr "\"source <path>/xcircuit.tcl\"."
   } else {
      # if there are multiple installed versions, choose the highest version.
      if {[llength $xcircscript] > 1} {
        set xcircscript [lindex [lsort -decreasing -dictionary $xcircscript] 0]
      }
      set argv $args
      set argc [llength $args]
      uplevel #0 source $xcircscript
   }
}

# Setup Magic assuming that the Tcl version is installed.

proc magic { args } {
   global CAD_ROOT
   global argc
   global argv
   set magicscript [glob -nocomplain ${CAD_ROOT}/magic/tcl/magic.tcl]
   if { ${magicscript} == {} } {
      puts stderr "\"magic\" requires Tcl-based Magic version 7.2 or newer."
      puts stderr "Could not find script \"magic.tcl\".  If Magic is installed in a"
      puts stderr "place other than CAD_ROOT (=${CAD_ROOT}), use the command"
      puts stderr "\"source <path>/magic.tcl\"."
   } else {
      set argv $args
      set argc [llength $args]
      uplevel #0 source $magicscript
   }
}

#----------------------------------------------------------------------------
# Have we called netgen from tkcon or a clone thereof?  If so, set NetgenConsole
#----------------------------------------------------------------------------

if {! $UsingMagic } {
   if {[lsearch [interp aliases] tkcon] != -1} {
      set NetgenConsole tkcon
      wm withdraw .
   }
}

pushnamespace netgen

#----------------------------------------------------------------------------
# For now, if we are standalone, pop down the default Tk window.
# Sometime later we may wish to provide a standalone GUI frontend in Tk
# to improve upon the original X11 "xnetgen" frontend.  If so, its
# definitions would go below.

if {! $UsingMagic } {
   if {[lsearch [interp aliases] tkcon] != -1} {
      if {[string range [wm title .] 0 3] == "wish"} {
	 wm withdraw .
      }
   }
}

#----------------------------------------------------------------------------
# No-console mode drops "--" in front of the argument list and "-noc"
# is retained, so remove them.  Internally, the console will be determined
# by checking for a slave interpreter, so there is no need for any
# action here other than removing the argument.

if {[lindex $argv 0] == "--"} {
   incr argc -1
   set argv [lrange $argv 1 end]
}

if {[string range [lindex $argv 0] 0 3] == "-noc"} {
   incr argc -1
   set argv [lrange $argv 1 end]
}

if {[string range [lindex $argv 0] 0 3] == "-bat"} {
   incr argc -1
   set argv [lrange $argv 1 end]
   set batchmode 1
}

#----------------------------------------------------------------------------
# Anything on the command line is assumed to be a netgen command to evaluate

if {[catch {eval $argv}]} {
   puts stdout "$errorInfo"
}
if {$batchmode == 1} {quit}

#----------------------------------------------------------------------------
# Netgen start function drops back to interpreter after initialization & setup
